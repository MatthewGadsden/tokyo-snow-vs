      "settings": {
        "foreground": "#f2aa4c",
        "fontStyle": "italic"
      }
    },

    // Constants and Numbers
    {
      "name": "Constants, Numbers, Booleans",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "keyword.other.unit"
