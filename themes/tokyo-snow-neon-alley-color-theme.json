    "notebookStatusRunningIcon.foreground": "#f2aa4c",
    "notebookStatusSuccessIcon.foreground": "#a9c46f"
  },
  "semanticTokenColors": {
    "parameter": { "foreground": "#f4cc72", "italic": true },
    "property": "#c9d48a",
    "enumMember": "#f07f3c",
    "typeParameter": { "foreground": "#f2aa4c", "italic": true },
    "namespace": "#f2aa4c",
    "interface": "#f2aa4c",
    "builtinType": "#f2aa4c",
    "selfKeyword": { "foreground": "#e8492b", "italic": true },
    "macro": "#f07f3c",
    "lifetime": { "foreground": "#f07f3c", "italic": true }
  },
  "tokenColors": [
    // Comments
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#807a5c"
      }
    },
    {
      "name": "Comment Keywords",
      "scope": [
        "comment.line.double-slash keyword",
        "comment.block keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c9d48a"
      }
    },

    // Variables and Parameters
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.destructuring"
      ],
      "settings": {
        "foreground": "#f4cc72"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#f4cc72",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self",
        "variable.language.special.self",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#e8492b",
        "fontStyle": "italic"
      }
    },

    // Functions and Methods
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "meta.method-call entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#7fae6a"
      }
    },

    // Strings and Characters
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
