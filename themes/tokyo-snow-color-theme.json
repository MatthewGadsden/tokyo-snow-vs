    "enumMember": "#db814c",
    "typeParameter": { "foreground": "#e1b568", "italic": true },
    "namespace": "#e1b568",
    "interface": "#e1b568",
    "builtinType": "#e1b568",
    "selfKeyword": { "foreground": "#d5583d", "italic": true },
    "macro": "#db814c",
    "lifetime": { "foreground": "#db814c", "italic": true }
  },
  "tokenColors": [
    // Comments
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7d7860"
      }
    },
    {
      "name": "Comment Keywords",
      "scope": [
        "comment.line.double-slash keyword",
        "comment.block keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c4c88e"
      }
    },

    // Variables and Parameters
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.destructuring"
      ],
      "settings": {
        "foreground": "#ecd08f"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#ecd08f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.language.self",
        "variable.language.special.self",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#d5583d",
        "fontStyle": "italic"
      }
    },

    // Functions and Methods
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "meta.method-call entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#6fc28a"
      }
    },

    // Strings and Characters
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a6d46c"
      }
    },
    {
      "name": "Template Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#db814c"
      }
    },
    {
      "name": "String Escape Characters",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#db814c"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.escape.regexp"
      ],
      "settings": {
        "foreground": "#c4c88e"
      }
    },

    // Properties and Object Keys
    {
      "name": "Object Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.type.property-name.toml",
        "keyword.key.toml"
      ],
      "settings": {
        "foreground": "#c4c88e"
      }
    },

    // Keywords and Control Flow
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d5583d"
      }
    },
    {
      "name": "Import/Export Keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#d5583d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Arrow Functions",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#d5583d"
      }
    },

    // Types and Classes
    {
      "name": "Classes and Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.built-in",
        "storage.type.primitive",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#e1b568"
      }
    },
    {
      "name": "Type Parameters and Generics",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#e1b568",
        "fontStyle": "italic"
      }
    },

    // Constants and Numbers
    {
      "name": "Constants, Numbers, Booleans",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#db814c"
      }
    },

    // Operators and Punctuation
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#ecd08f"
      }
    },
    {
      "name": "Special Operators",
      "scope": [
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.rest",
        "keyword.operator.optional"
      ],
      "settings": {
        "foreground": "#d5583d"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ecd08fb3"
      }
    },

    // HTML/XML
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d5583d"
      }
    },
    {
      "name": "HTML/XML Tag Punctuation",
      "scope": [
        "punctuation.definition.tag",
        "meta.tag.sgml.doctype"
      ],
      "settings": {
        "foreground": "#7d7860"
      }
    },
    {
      "name": "HTML/XML Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e1b568"
      }
    },

    // CSS
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#e1b568"
      }
    },
    {
      "name": "CSS Pseudo Selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#c4c88e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#c4c88e"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit.css",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#db814c"
      }
    },
    {
      "name": "CSS Functions",
      "scope": [
        "support.function.css"
      ],
      "settings": {
        "foreground": "#6fc28a"
      }
    },

    // Decorators, Annotations, Macros
    {
      "name": "Decorators and Annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator variable.other.readwrite",
        "meta.decorator punctuation.decorator",
        "meta.function.decorator.python",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#db814c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.macro",
        "support.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#db814c"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime",
        "storage.modifier.lifetime",
        "punctuation.definition.lifetime"
      ],
      "settings": {
        "foreground": "#db814c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#db814c"
      }
    },

    // Markdown
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#e1b568",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Header Punctuation",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#d5583d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold.markdown"
      ],
      "settings": {
        "foreground": "#f1e4b5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic.markdown"
      ],
      "settings": {
        "foreground": "#f1e4b5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a6d46c"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6fc28a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#c4c88e"
      }
    },
    {
      "name": "Markdown Lists",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#d5583d"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#7d7860",
        "fontStyle": "italic"
      }
    },

    // Shell
    {
      "name": "Shell Variables",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.positional.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell",
        "variable.other.env"
      ],
      "settings": {
        "foreground": "#c4c88e"
      }
    },

    // Diff and Git
    {
      "name": "Diff Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a6d46c"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#d5583d"
      }
    },
    {
      "name": "Diff Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e1b568"
      }
    },
    {
      "name": "Diff Header",
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#6fc28a"
      }
    },
    {
      "name": "Git Commit Hash",
      "scope": [
        "constant.other.git.commit-hash"
      ],
      "settings": {
        "foreground": "#6fc28a"
      }
    },

    // Invalid and Deprecated
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d5583d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#e1b568",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
